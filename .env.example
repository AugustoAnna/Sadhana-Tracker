# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Seconds between codes to the same address. Keep equal to Supabase →
# Authentication → Rate Limits (per-user email interval). Default 60.
VITE_OTP_RESEND_SECONDS=60
