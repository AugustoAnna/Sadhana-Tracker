# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Countdown on the code step before "Resend code" is offered again. Keep equal
# to Supabase → Authentication → Rate Limits (per-address email interval).
# Default 60; 0 disables the countdown.
VITE_OTP_RESEND_SECONDS=60
