# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Email sign-in. Unset/false = anonymous sessions allowed, email offered as
# "keep your progress". true = email code required before the app opens.
# Only set to true once Supabase custom SMTP is delivering codes.
VITE_REQUIRE_EMAIL_SIGN_IN=false
